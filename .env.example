# Copy to .env for local development. On Railway set these as service variables.
# NEVER commit a real .env - it is git-ignored for a reason.

# ---- required for the agent graph ----
OPENAI_API_KEY=sk-proj-...
# Shared default for every agent except the two overridden below (see
# WEIGHER_MODEL/SPECIALIST_MODEL) - structured extraction and narrow,
# already-grounded completions, called often per turn, so a small/cheap model
# is the right fit. See notes/01-agent-architecture.md's "Model selection"
# section.
LLM_MODEL=gpt-4o-mini
# decision_weigher only: the single most complex reasoning step in the graph
# (synthesise three specialist reports, hold five hard rules simultaneously,
# stay internally consistent, emit valid JSON), called once per turn - the
# reliability payoff of a stronger model here comfortably outweighs the small
# added cost. Has its own independent default (gpt-4o), not tied to
# LLM_MODEL's value - set it equal to LLM_MODEL to opt back into one shared
# model everywhere.
WEIGHER_MODEL=gpt-4o
# The three specialists (weather/logistics/recommendations): briefly moved to
# gpt-4o, then rolled back - this org's real gpt-4o rate limit is 30,000
# tokens/minute, and four gpt-4o agents per comparison turn (three concurrent
# specialists plus the weigher) reliably tripped it under ordinary load
# (reproduced at a 62% failure rate), silently dropping a candidate's card or
# emptying the whole comparison. Defaults to gpt-4o-mini so the specialists
# share the weigher's rate-limit budget for one gpt-4o call per turn, not
# four. Raise this again (e.g. back to gpt-4o) only once this org's gpt-4o
# TPM limit is confirmed higher - it is a one-line change either way.
SPECIALIST_MODEL=gpt-4o-mini
# Deliberately a different model line than LLM_MODEL by default: a judge from
# the same model family shares its blind spots with what it is grading.
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ---- auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=720
# The admin panel password. Set this in Railway, never in source.
ADMIN_PASSWORD=change-me
# Demo safety: approve new registrations instantly so a cold visitor is never
# blocked waiting for a human to click approve. Leave false for real gating.
ADMIN_AUTO_APPROVE=false

# ---- storage ----
# On Railway point this at the mounted volume, e.g. /data
DATA_DIR=./data
# DB_PATH defaults to $DATA_DIR/onward.sqlite3

# ---- RAG (optional: falls back to a local JSON index when unset) ----
PINECONE_API_KEY=
PINECONE_INDEX=onward-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- tracing (optional: tracing no-ops when unset) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- misc ----
WORKING_MEMORY_TURNS=20
CORS_ORIGINS=http://localhost:5173
SERVE_FRONTEND=true

# ---- Google Places API (New) ----
# Enable "Places API (New)" in Google Cloud and restrict the key to it.
# Without this the place-recommendation tools report configured:false and the
# agent says it has no live place data, rather than erroring.
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_TTL_SECONDS=86400
PLACES_MIN_REVIEWS=25

# ---- affiliate deep links (URL construction only, no API) ----
BOOKING_AFFILIATE_ID=
HOSTELWORLD_AFFILIATE_ID=

# ---- live RAG-gap lookup (optional) ----
# When a scoped RAG search for a destination comes back empty, and this key is
# set, the search tools fall back to a real web search + two-pass LLM
# synthesis/verification instead of just reporting "no data" (see
# backend/rag/live_lookup.py and notes/03-rag-and-retrieval.md). The result is
# written into the same curated visa/seasonal/tips/routes namespace its kind
# belongs to (tagged origin=live in its metadata, purely for internal
# debugging - once verified it is presented to the traveller as real
# information, same as curated content, not flagged as unconfirmed).
# Without this key the behaviour is unchanged: an empty scoped search stays
# honestly empty. Get a key at https://tavily.com (free tier available).
TAVILY_API_KEY=
