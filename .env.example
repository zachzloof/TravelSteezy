# Copy to .env for local development. On Railway set these as service variables.
# NEVER commit a real .env - it is git-ignored for a reason.

# ---- required for the agent graph ----
OPENAI_API_KEY=sk-proj-...
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=720
# The admin panel password. Set this in Railway, never in source.
ADMIN_PASSWORD=change-me
# Demo safety: approve new registrations instantly so a cold visitor is never
# blocked waiting for a human to click approve. Leave false for real gating.
ADMIN_AUTO_APPROVE=false

# ---- storage ----
# On Railway point this at the mounted volume, e.g. /data
DATA_DIR=./data
# DB_PATH defaults to $DATA_DIR/onward.sqlite3

# ---- RAG (optional: falls back to a local JSON index when unset) ----
PINECONE_API_KEY=
PINECONE_INDEX=onward-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- tracing (optional: tracing no-ops when unset) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- misc ----
WORKING_MEMORY_TURNS=20
CORS_ORIGINS=http://localhost:5173
SERVE_FRONTEND=true

# ---- Google Places API (New) ----
# Enable "Places API (New)" in Google Cloud and restrict the key to it.
# Without this the place-recommendation tools report configured:false and the
# agent says it has no live place data, rather than erroring.
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_TTL_SECONDS=86400
PLACES_MIN_REVIEWS=25

# ---- affiliate deep links (URL construction only, no API) ----
BOOKING_AFFILIATE_ID=
HOSTELWORLD_AFFILIATE_ID=

# ---- live RAG-gap lookup (optional) ----
# When a scoped RAG search for a destination comes back empty, and this key is
# set, the search tools fall back to a real web search + two-pass LLM
# synthesis/verification instead of just reporting "no data" (see
# backend/rag/live_lookup.py and notes/03-rag-and-retrieval.md). The result is
# written into the same curated visa/seasonal/tips/routes namespace its kind
# belongs to (tagged origin=live in its metadata, purely for internal
# debugging - once verified it is presented to the traveller as real
# information, same as curated content, not flagged as unconfirmed).
# Without this key the behaviour is unchanged: an empty scoped search stays
# honestly empty. Get a key at https://tavily.com (free tier available).
TAVILY_API_KEY=
